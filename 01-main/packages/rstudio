DEFVER=2
ARCHS_SUPPORTED="amd64"
CODENAMES_SUPPORTED="jammy noble"
get_website "https://docs.posit.co/ide/user/#direct-downloads-open-source"
local URLS
if [ "${ACTION}" != "prettylist" ]; then
    mapfile -t URLS < <(grep -Eo 'https://download1\.rstudio\.org/electron/[^/[:space:]]+/amd64/rstudio-[^/[:space:]]+-amd64\.deb' "${CACHE_FILE}")
    if [ "${#URLS[@]}" -eq 1 ]; then
        URL="${URLS[0]}"
        VERSION_PUBLISHED=${URL##*/rstudio-}
        VERSION_PUBLISHED=${VERSION_PUBLISHED%-amd64.deb}
    fi
fi
PRETTY_NAME="RStudio"
WEBSITE="https://posit.co/"
#https://posit.co/products/open-source/rstudio/
SUMMARY="Professional software for data science teams."
